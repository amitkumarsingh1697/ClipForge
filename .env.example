# --- core ---
API_TOKEN=                     # leave empty on your own Mac (UI only reachable from this computer); set a long random string on a server
DATA_DIR=./data                # /data inside Docker
TASK_MODE=thread               # thread = one process (python -m app.cli serve); celery = Docker/Redis workers

# --- clip shape ---
CLIP_MIN_S=15
CLIP_TARGET_S=30
CLIP_MAX_S=300                 # 5 min max; Shorts count up to 3 min
CLIPS_PER_SOURCE=3
OUTPUT_FORMATS=vertical        # default formats: vertical,portrait,square,landscape (the UI lets you pick per job)

# --- whisper (local, free) ---
WHISPER_MODEL=small            # tiny/base on weak CPUs, medium/large-v3 with a GPU
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
CAPTIONS_ENABLED=true

# --- viral look (defaults; the UI lets you change them per job) ---
CAPTION_STYLE=pop              # pop | classic | minimal | none
HOOK_OVERLAY=true
PROGRESS_BAR=true
JUMP_CUTS=true                 # remove dead air between sentences
ZOOM_PUNCH=true                # punch-in zooms on key words
COVER_INTRO=true               # cover image as the first frames (becomes the thumbnail everywhere)
PAYOFF_TEASE=true              # open with ~2 s of the best moment ("wait for it"), then the clip
PAYOFF_REPLAY=true             # end on a slow-mo zoomed replay that loops back into the start
BEAT=true                      # background beat ducked under speech (your tracks in DATA_DIR/music, else a built-in one)
BEAT_VOLUME=0.12

# --- live streams ---
LIVE_SEGMENT_S=120
LIVE_MAX_HOURS=6
LIVE_HIGHLIGHT_RATIO=1.6

# --- Telegram (create a bot with @BotFather, then run `python -m app.cli telegram-setup`) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=       # only if you use the HTTPS webhook instead of the poller

# --- YouTube (OAuth client type "Desktop app"; consent screen "In production") ---
YOUTUBE_CLIENT_SECRETS=        # leave empty and upload the JSON in the UI (saved to data/secrets/)
YOUTUBE_PRIVACY=public         # public | unlisted | private. Google locks uploads from unaudited API projects to private; ClipForge checks and tells you
YOUTUBE_CATEGORY_ID=20         # fallback only; each clip gets a category that matches it (1 Film & Animation for trailers, 20 Gaming...)
PUBLISH_SPACING_MIN=90         # clips from the same video are spaced this far apart (stops duplicate-looking bursts); 0 = off

# --- Instagram (Business/Creator account linked to a Facebook Page) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- TikTok (connect in the UI; unaudited apps can only post privately) ---
TIKTOK_PRIVACY=SELF_ONLY

DEFAULT_HASHTAGS=#shorts
