# --- required ---
API_TOKEN=change-me-to-a-long-random-string     # sent by your phone shortcut as X-API-Token
DATA_DIR=/data

# --- clip shape ---
CLIP_MIN_S=15
CLIP_TARGET_S=30
CLIP_MAX_S=60
CLIPS_PER_SOURCE=3

# --- whisper (local, free) ---
WHISPER_MODEL=small            # tiny/base on weak CPUs, medium/large-v3 with a GPU
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
CAPTIONS_ENABLED=true

# --- live streams ---
LIVE_SEGMENT_S=120
LIVE_MAX_HOURS=6
LIVE_HIGHLIGHT_RATIO=1.6

# --- Telegram (create a bot with @BotFather; get your id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=       # only if you use the HTTPS webhook instead of the poller

# --- YouTube (OAuth client type "Desktop app"; consent screen "In production") ---
YOUTUBE_CLIENT_SECRETS=/data/secrets/client_secret.json
YOUTUBE_PRIVACY=private        # unaudited API projects are forced to private anyway

# --- Instagram (Business/Creator account linked to a Facebook Page) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GRAPH_API_VERSION=v21.0

DEFAULT_HASHTAGS=#gta6 #gaming #shorts
